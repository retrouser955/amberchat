# Comma-separated Gun relay URLs used for relay/sync.
# Defaults to http://localhost:3000/gun when unset.
PUBLIC_GUN_RELAY=http://localhost:3000/gun

# Optional TURN server for voice/video calls. STUN-only calls work on many
# networks, but a TURN relay is required for reliable calls behind strict NATs.
# PUBLIC_TURN_URL=turn:turn.example.com:3478
# PUBLIC_TURN_USERNAME=user
# PUBLIC_TURN_CREDENTIAL=password
